{
  "manifest_version": 3,
  "name": "AI店长 - 数据同步助手",
  "version": "2.0.0",
  "description": "自动从美团商家后台同步订单/商品/评价数据到 AI店长系统",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://yiyao.meituan.com/*",
    "https://qnh.meituan.com/*",
    "https://*.meituan.com/*",
    "http://192.144.227.205:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://yiyao.meituan.com/*",
        "https://qnh.meituan.com/*"
      ],
      "js": ["content_script.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": [
        "https://yiyao.meituan.com/*",
        "https://qnh.meituan.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
