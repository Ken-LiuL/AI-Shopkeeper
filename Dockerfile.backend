FROM python:3.11-slim

# Only install fonts for PDF/report generation (no browser needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-noto-cjk \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.backend.txt ./
RUN pip install --no-cache-dir --prefer-binary --retries 10 --timeout 120 -r requirements.backend.txt

COPY src/ src/
COPY config/ config/
COPY migrations/ migrations/
COPY scripts/ scripts/
COPY data/ data/

COPY scripts/start.sh /app/start.sh
RUN chmod +x /app/start.sh

EXPOSE 8000
CMD ["/app/start.sh"]
