FROM python:3.11-slim

WORKDIR /app

COPY requirements.backend.txt ./
RUN pip install --no-cache-dir --prefer-binary --retries 10 --timeout 120 -r requirements.backend.txt

COPY src/ src/
COPY config/ config/
COPY migrations/ migrations/
COPY scripts/ scripts/
COPY data/ data/
COPY sample/ sample/

COPY scripts/start.sh /app/start.sh
RUN chmod +x /app/start.sh

EXPOSE 8000
CMD ["/app/start.sh"]
