{
  "manifest_version": 3,
  "name": "AI店长数据同步器",
  "version": "1.0.0",
  "description": "美团牵牛花后台数据自动同步到 AI 店长系统",

  "permissions": [
    "storage",
    "alarms",
    "activeTab"
  ],

  "host_permissions": [
    "*://qnh.meituan.com/*",
    "https://ai-shopkeeper-kk.fly.dev/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://qnh.meituan.com/*"],
      "js": ["lib/api.js", "config/data_sources.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://qnh.meituan.com/*"]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "AI店长同步状态",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_page": "options.html",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
