# AI 店长 环境变量配置
# 复制为 .env 并填入真实值

# ── LLM ──────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# ── 美团商家后台 ─────────────────────────────────────
WM_POI_ID=30850916
# Cookie JSON（可选，也可通过前端设置页提交）
# YIYAO_COOKIES_JSON={"key":"value"}

# ── 数据采集 ─────────────────────────────────────────
SYNC_MODE=local
DISABLE_SYNC=false
# 同步 API 密钥（用于外部 daemon 推数据，可选）
# SYNC_API_KEY=your-sync-key

# ── 数据库（Docker Compose 内部使用，一般不用改）─────
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_store
# NEO4J_URI=bolt://neo4j:7687
# REDIS_URL=redis://redis:6379

# ── 通知（可选）─────────────────────────────────────
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# ── 默认店铺 ID ─────────────────────────────────────
DEFAULT_STORE_ID=30850916
