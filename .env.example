# AI 店长 环境变量配置
# 复制为 .env 并填入真实值

# ── LLM ──────────────────────────────────────────────
# Provider: openrouter | deepseek | anthropic
LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# DeepSeek 直连（当 LLM_PROVIDER=deepseek 时生效）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# ── 认证 ─────────────────────────────────────────────
# 管理员密码（首次部署必须设置，不设置会生成随机密码）
ADMIN_PASSWORD=your-secure-password-here

# ── 数据同步 ─────────────────────────────────────────
# 同步模式已迁移至 Chrome 扩展 + 手动上传
DISABLE_SYNC=true
# 同步 API 密钥（Chrome 扩展推数据用）
# SYNC_API_KEY=your-sync-key

# ── 数据库（Docker Compose 内部使用，一般不用改）─────
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_store
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=changeme123
# REDIS_URL=redis://redis:6379

# ── 通知（可选）─────────────────────────────────────
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# ── 默认店铺 ID ─────────────────────────────────────
DEFAULT_STORE_ID=30850916
