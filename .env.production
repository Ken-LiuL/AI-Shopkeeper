# === Railway 部署环境变量模板 ===
# 以下变量需要在 Railway Dashboard > Variables 中设置
# 标记 [AUTO] 的由 Railway 插件自动注入，无需手动设置

# [AUTO] PostgreSQL - Railway Postgres 插件自动注入
# DATABASE_URL=postgresql://...
POSTGRES_HOST=${PGHOST}
POSTGRES_PORT=${PGPORT}
POSTGRES_DB=${PGDATABASE}
POSTGRES_USER=${PGUSER}
POSTGRES_PASSWORD=${PGPASSWORD}

# [AUTO] Redis - Railway Redis 插件自动注入
# REDIS_URL=redis://...

# Vector store 模式 (不再使用 Neo4j)
VECTOR_STORE=postgres

# Neo4j 禁用 (留空即可，代码会 graceful fallback)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# LLM API - 通过 OpenRouter
OPENROUTER_API_KEY=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

# Langfuse (可选，不需要可留空)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Prometheus (Railway 上关闭)
PROMETHEUS_ENABLED=false
